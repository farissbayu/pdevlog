{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pdevlog",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pdevlog-db",
      "database_id": "942aeb87-c2e8-4a6d-ba58-66cdd5990aae",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "pdevlog-storage",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "AI_QUEUE",
        "queue": "pdevlog-ai-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "pdevlog-ai-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
    ],
  },
  "vars": {
    "ADMIN_EMAILS": "farissbay.dev@gmail.com",
    "AI_BASE_URL": "https://openrouter.ai/api/v1/chat/completions",
    "AI_MODEL": "openai/gpt-4o-mini",
    "APP_NAME": "pdevlog",
    "APP_URL": "https://pdevlog.farissbay.my.id",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
}
